    { "id": "IOC.PATH.SYSFILES_APPDATA", "regex": "\\\\appdata\\\\roaming\\\\(sysfiles|driversupdate|windowshelper)\\\\", "weight": 30, "text": "AppData folder with a system-sounding name used by miner droppers" }
