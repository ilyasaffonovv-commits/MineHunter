  "persistenceNameRules": [
    { "id": "NAME.MS.SYSTEM_HEALTH", "regex": "^windows system health", "weight": 25, "text": "Name imitates a Windows health/maintenance task (seen in 2026 GPU-miner campaign)" },
    { "id": "NAME.RUN.WINSYSCACHE", "regex": "^winsyscache$", "weight": 25, "text": "Run value name used by a known miner campaign" },
    { "id": "NAME.SVC.DRVSVC", "regex": "^drvsvc$", "weight": 25, "text": "Service name used by SilentCryptoMiner (mimics a driver/imaging service)" },
    { "id": "NAME.MS.UPDATER_FAKE", "regex": "^(google|adobe|java|nvidia|realtek|intel|amd|opera|yandex)[a-z ]*(update|updater|helper|service|task)[a-z ]*(machine|core|ua|qc|host|sys)?$", "weight": 6, "text": "Vendor-updater-like name (check the file it launches)" },
    { "id": "NAME.MS.GENERIC", "regex": "^(windows|microsoft|system|service|driver|runtime|security|defender|update|cache|health|host)[ _-]?(update|defender|security|health|cache|runtime|driver|service|host|task|monitor|check|manager|helper|control)s?( service| task)?$", "weight": 8, "text": "Generic Windows-sounding name" },
    { "id": "NAME.HOMOGLYPH_TAG", "regex": "^(reaitek|rea1tek|realtec|microsofl|micr0soft|nvldia|lntel)", "weight": 25, "text": "Look-alike spelling of a well-known vendor" }
  ],

