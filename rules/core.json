  "cmdlinePatterns": [
    { "id": "CMD.MINER.STRATUM_URL", "regex": "stratum2?\\+(tcp|ssl|tls|udp)://", "weight": 40, "definitive": false, "category": "Content", "text": "Command line points to a mining pool (stratum URL)" },
    { "id": "CMD.MINER.DONATE_LEVEL", "regex": "--donate-(level|over-proxy)", "weight": 40, "definitive": true, "category": "Content", "text": "XMRig-style --donate-level option in the command line" },
    { "id": "CMD.MINER.ALGO_FLAG", "regex": "(^|\\s)(-a|--algo)[= ]+(rx/|cn/|cn-|randomx|kawpow|ethash|etchash|autolykos|ergo|kheavyhash|scrypt|x16r|x16rv2|cryptonight|argon2|ghostrider|verushash|equihash)", "weight": 30, "definitive": false, "category": "Content", "text": "Mining algorithm selected on the command line" },
    { "id": "CMD.MINER.POOL_USER", "regex": "(^|\\s)(-o|--url)[= ]+\\S+:\\d{2,5}.*(^|\\s)(-u|--user)[= ]+\\S+", "weight": 35, "definitive": false, "category": "Content", "text": "Pool address plus user/wallet on the command line" },
    { "id": "CMD.MINER.WALLET_XMR", "regex": "\\b4[0-9AB][1-9A-HJ-NP-Za-km-z]{93}\\b", "weight": 35, "definitive": false, "category": "Content", "text": "Monero wallet address in the command line" },
    { "id": "CMD.MINER.POOL_NAME", "regex": "(supportxmr|minexmr|moneroocean|nanopool|2miners|herominers|hashvault|c3pool|f2pool|unmineable|ethermine|flexpool|nicehash|woolypooly|hiveon|kryptex|miningpoolhub|antpool|viabtc|poolin|zpool|prohashing|k1pool|ezil)\\.", "weight": 25, "definitive": false, "category": "Content", "text": "Command line references a known mining pool" },
    { "id": "CMD.MINER.CPU_TUNING", "regex": "--(cpu-priority|max-cpu-usage|cpu-affinity|randomx-mode|huge-pages|threads=\\d+.*--coin|coin[= ](xmr|monero|etc|rvn|ergo))", "weight": 20, "definitive": false, "category": "Content", "text": "Miner tuning options in the command line" },
    { "id": "CMD.PS.ENCODED", "regex": "powershell(\\.exe)?[^|&;]*\\s-(e|ec|enc|encodedcommand)\\s+[A-Za-z0-9+/=]{40,}", "weight": 25, "definitive": false, "category": "Persistence", "text": "Hidden PowerShell with an encoded command" },
    { "id": "CMD.PS.DOWNLOAD_EXEC", "regex": "(iex|invoke-expression)[^|]*\\b(downloadstring|invoke-webrequest|iwr|irm|invoke-restmethod|webclient)\\b|\\b(downloadstring|downloadfile)\\b.*(iex|invoke-expression|start-process)", "weight": 30, "definitive": false, "category": "Persistence", "text": "PowerShell downloads and runs code" },
    { "id": "CMD.DEFENDER.EXCLUSION", "regex": "(add|set)-mppreference[^|]*-exclusion(path|process|extension)", "weight": 35, "definitive": false, "category": "Tamper", "text": "Command adds Microsoft Defender exclusions" },
    { "id": "CMD.DEFENDER.EXCLUSION_BROAD", "regex": "(add|set)-mppreference[^|]*-exclusionpath\\s+[@(]*['\"]?([a-z]:\\\\?|%(temp|tmp|appdata|localappdata|programdata|userprofile|public)%\\\\?|[a-z]:\\\\(users|programdata|windows|program files)(\\\\?|\\\\[^\\\\'\"]+\\\\?))['\"]?\\s*(\\)|,|;|$|\\s-)", "weight": 45, "definitive": false, "category": "Tamper", "text": "Command excludes an entire drive or system folder from Microsoft Defender" },
    { "id": "CMD.DEFENDER.DISABLE", "regex": "(set-mppreference[^|]*-disable(realtimemonitoring|behaviormonitoring|ioavprotection|scriptscanning)|sc(\\.exe)?\\s+(stop|config)\\s+windefend|disableantispyware)", "weight": 35, "definitive": false, "category": "Tamper", "text": "Command disables Microsoft Defender" },
    { "id": "CMD.LOLBIN.REMOTE", "regex": "(mshta(\\.exe)?\\s+https?://|regsvr32(\\.exe)?[^|]*/i:https?://|rundll32(\\.exe)?\\s+javascript:|certutil(\\.exe)?[^|]*-urlcache[^|]*http|bitsadmin(\\.exe)?[^|]*/transfer)", "weight": 35, "definitive": false, "category": "Persistence", "text": "Living-off-the-land binary fetches remote content" },
    { "id": "CMD.CMD.CHAIN", "regex": "cmd(\\.exe)?\\s+/c\\s+.*(&&|&)\\s*(start|powershell|schtasks|reg\\s+add|attrib)", "weight": 12, "definitive": false, "category": "Persistence", "text": "cmd.exe chain that starts other tools" },
    { "id": "CMD.SCHTASKS.MINUTE", "regex": "schtasks(\\.exe)?\\s+/create[^|]*/sc\\s+minute[^|]*/mo\\s+[1-5]\\b", "weight": 20, "definitive": false, "category": "Persistence", "text": "Task created to run every few minutes (respawn / watchdog pattern)" },
    { "id": "CMD.POWERCFG.NEVER", "regex": "powercfg(\\.exe)?\\s+[^|]*(hibernate\\s+off|-h\\s+off|standby-timeout-(ac|dc)\\s+0)", "weight": 6, "definitive": false, "category": "Behavior", "text": "Sleep/hibernate disabled (common in miner installers)" },
    { "id": "CMD.RDP.WRAPPER", "regex": "(rdpwinst|rdpwrap)", "weight": 25, "definitive": false, "category": "Persistence", "text": "RDP Wrapper installation (used by many miner/RAT bundles)" }
  ],

