<Project>
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>MineHunter</Product>
    <Company>MineHunter</Company>
    <Copyright>MIT</Copyright>
    <Description>Local anti-miner and persistence hunter. No telemetry.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <WarningLevel>4</WarningLevel>
    <NoWarn>CS1591;CS0649;CS0169;CS0414;CS8632</NoWarn>
    <!-- every project writes next to the others: the portable layout is then assembled from one folder -->
    <OutDir>$(MSBuildThisFileDirectory)_bin\</OutDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RestoreUseStaticGraphEvaluation>false</RestoreUseStaticGraphEvaluation>
  </PropertyGroup>
</Project>
