<Window xmlns='http://schemas.microsoft.com/winfx/2006/xaml/presentation'
        xmlns:x='http://schemas.microsoft.com/winfx/2006/xaml'
        Title='MineHunter' Width='1180' Height='820' MinWidth='980' MinHeight='680'
        WindowStartupLocation='CenterScreen' Background='#0E1220' Foreground='#E8ECF7'
        FontFamily='Segoe UI' FontSize='13' UseLayoutRounding='True' SnapsToDevicePixels='True'
        TextOptions.TextFormattingMode='Display' TextOptions.TextRenderingMode='ClearType'>
  <Window.Resources>
    <SolidColorBrush x:Key='Bg' Color='#0E1220'/>
    <SolidColorBrush x:Key='Surface' Color='#161B2E'/>
    <SolidColorBrush x:Key='Surface2' Color='#1D2440'/>
    <SolidColorBrush x:Key='Line' Color='#2A3253'/>
    <SolidColorBrush x:Key='Text' Color='#E8ECF7'/>
    <SolidColorBrush x:Key='Muted' Color='#8E99BA'/>
    <SolidColorBrush x:Key='Accent' Color='#4C8DFF'/>
    <SolidColorBrush x:Key='Good' Color='#2ECC8F'/>
    <SolidColorBrush x:Key='Warn' Color='#F5B942'/>
    <SolidColorBrush x:Key='Orange' Color='#FF8A3D'/>
    <SolidColorBrush x:Key='Bad' Color='#FF4D5E'/>

    <!-- ============ buttons ============ -->
    <Style x:Key='Btn' TargetType='Button'>
      <Setter Property='Foreground' Value='#E8ECF7'/>
      <Setter Property='Background' Value='#1D2440'/>
      <Setter Property='BorderBrush' Value='#2A3253'/>
      <Setter Property='BorderThickness' Value='1'/>
      <Setter Property='Padding' Value='16,9'/>
      <Setter Property='FontWeight' Value='SemiBold'/>
      <Setter Property='Cursor' Value='Hand'/>
      <Setter Property='Template'>
        <Setter.Value>
          <ControlTemplate TargetType='Button'>
            <Border x:Name='bd' Background='{TemplateBinding Background}' BorderBrush='{TemplateBinding BorderBrush}' BorderThickness='{TemplateBinding BorderThickness}' CornerRadius='9' Padding='{TemplateBinding Padding}'>
              <ContentPresenter HorizontalAlignment='Center' VerticalAlignment='Center' RecognizesAccessKey='False'/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property='IsMouseOver' Value='True'><Setter TargetName='bd' Property='Opacity' Value='0.86'/></Trigger>
              <Trigger Property='IsPressed' Value='True'><Setter TargetName='bd' Property='Opacity' Value='0.7'/></Trigger>
              <Trigger Property='IsEnabled' Value='False'><Setter TargetName='bd' Property='Opacity' Value='0.4'/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key='BtnPrimary' TargetType='Button' BasedOn='{StaticResource Btn}'>
      <Setter Property='Background' Value='#4C8DFF'/><Setter Property='BorderBrush' Value='#4C8DFF'/><Setter Property='Foreground' Value='White'/>
    </Style>
    <Style x:Key='BtnDanger' TargetType='Button' BasedOn='{StaticResource Btn}'>
      <Setter Property='Background' Value='#E5384B'/><Setter Property='BorderBrush' Value='#E5384B'/><Setter Property='Foreground' Value='White'/>
    </Style>
    <Style x:Key='BtnGhost' TargetType='Button' BasedOn='{StaticResource Btn}'>
      <Setter Property='Background' Value='Transparent'/>
    </Style>
    <Style x:Key='BtnSeg' TargetType='Button' BasedOn='{StaticResource Btn}'>
      <Setter Property='Padding' Value='10,4'/><Setter Property='FontSize' Value='12'/><Setter Property='BorderThickness' Value='0'/><Setter Property='Background' Value='Transparent'/><Setter Property='Foreground' Value='#8E99BA'/>
    </Style>

    <!-- ============ check box ============ -->
    <Style TargetType='CheckBox'>
      <Setter Property='Foreground' Value='#E8ECF7'/>
      <Setter Property='Cursor' Value='Hand'/>
      <Setter Property='Template'>
        <Setter.Value>
          <ControlTemplate TargetType='CheckBox'>
            <StackPanel Orientation='Horizontal' Background='Transparent'>
              <Border x:Name='box' Width='18' Height='18' CornerRadius='5' BorderThickness='1.5' BorderBrush='#8E99BA' Background='Transparent' VerticalAlignment='Center'>
                <Path x:Name='tick' Data='M3.5,9 L7.5,13 L14.5,4.5' Stroke='White' StrokeThickness='2' StrokeStartLineCap='Round' StrokeEndLineCap='Round' StrokeLineJoin='Round' Visibility='Collapsed' Margin='0,0,0,0'/>
              </Border>
              <ContentPresenter Margin='8,0,0,0' VerticalAlignment='Center' RecognizesAccessKey='False'/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property='IsChecked' Value='True'>
                <Setter TargetName='box' Property='Background' Value='#4C8DFF'/>
                <Setter TargetName='box' Property='BorderBrush' Value='#4C8DFF'/>
                <Setter TargetName='tick' Property='Visibility' Value='Visible'/>
              </Trigger>
              <Trigger Property='IsEnabled' Value='False'><Setter Property='Opacity' Value='0.5'/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ scroll bars ============ -->
    <Style x:Key='ScrollThumb' TargetType='Thumb'>
      <Setter Property='Template'>
        <Setter.Value>
          <ControlTemplate TargetType='Thumb'><Border CornerRadius='4' Background='#38426B' Margin='2'/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key='ScrollPage' TargetType='RepeatButton'>
      <Setter Property='Template'>
        <Setter.Value>
          <ControlTemplate TargetType='RepeatButton'><Border Background='Transparent'/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <ControlTemplate x:Key='VScroll' TargetType='ScrollBar'>
      <Grid Background='Transparent'>
        <Track x:Name='PART_Track' IsDirectionReversed='True'>
          <Track.DecreaseRepeatButton><RepeatButton Command='ScrollBar.PageUpCommand' Style='{StaticResource ScrollPage}'/></Track.DecreaseRepeatButton>
          <Track.IncreaseRepeatButton><RepeatButton Command='ScrollBar.PageDownCommand' Style='{StaticResource ScrollPage}'/></Track.IncreaseRepeatButton>
          <Track.Thumb><Thumb Style='{StaticResource ScrollThumb}'/></Track.Thumb>
        </Track>
      </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key='HScroll' TargetType='ScrollBar'>
      <Grid Background='Transparent'>
        <Track x:Name='PART_Track' IsDirectionReversed='False'>
          <Track.DecreaseRepeatButton><RepeatButton Command='ScrollBar.PageLeftCommand' Style='{StaticResource ScrollPage}'/></Track.DecreaseRepeatButton>
          <Track.IncreaseRepeatButton><RepeatButton Command='ScrollBar.PageRightCommand' Style='{StaticResource ScrollPage}'/></Track.IncreaseRepeatButton>
          <Track.Thumb><Thumb Style='{StaticResource ScrollThumb}'/></Track.Thumb>
        </Track>
      </Grid>
    </ControlTemplate>
    <Style TargetType='ScrollBar'>
      <Setter Property='Background' Value='Transparent'/>
      <Setter Property='Width' Value='12'/>
      <Setter Property='Height' Value='Auto'/>
      <Setter Property='Template' Value='{StaticResource VScroll}'/>
      <Style.Triggers>
        <Trigger Property='Orientation' Value='Horizontal'>
          <Setter Property='Width' Value='Auto'/>
          <Setter Property='Height' Value='12'/>
          <Setter Property='Template' Value='{StaticResource HScroll}'/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ============ tabs ============ -->
    <Style TargetType='TabControl'>
      <Setter Property='Foreground' Value='#E8ECF7'/>
      <Setter Property='Background' Value='Transparent'/>
      <Setter Property='BorderThickness' Value='0'/>
      <Setter Property='Padding' Value='0'/>
      <Setter Property='Template'>
        <Setter.Value>
          <ControlTemplate TargetType='TabControl'>
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height='Auto'/><RowDefinition Height='*'/></Grid.RowDefinitions>
              <Border BorderBrush='#2A3253' BorderThickness='0,0,0,1'><TabPanel IsItemsHost='True'/></Border>
              <ContentPresenter Grid.Row='1' ContentSource='SelectedContent' Margin='0,14,0,0'/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType='TabItem'>
      <Setter Property='Foreground' Value='#E8ECF7'/>
      <Setter Property='Template'>
        <Setter.Value>
          <ControlTemplate TargetType='TabItem'>
            <Border x:Name='hd' Padding='16,10' Margin='0,0,4,-1' BorderThickness='0,0,0,2' BorderBrush='Transparent' Background='Transparent' Cursor='Hand'>
              <ContentPresenter x:Name='cp' ContentSource='Header' TextElement.Foreground='#8E99BA' TextElement.FontWeight='SemiBold'/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property='IsMouseOver' Value='True'><Setter TargetName='cp' Property='TextElement.Foreground' Value='#C9D2EE'/></Trigger>
              <Trigger Property='IsSelected' Value='True'>
                <Setter TargetName='hd' Property='BorderBrush' Value='#4C8DFF'/>
                <Setter TargetName='cp' Property='TextElement.Foreground' Value='#FFFFFF'/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ list ============ -->
    <Style x:Key='FlatList' TargetType='ListBox'>
      <Setter Property='Background' Value='Transparent'/>
      <Setter Property='BorderThickness' Value='0'/>
      <Setter Property='Padding' Value='0'/>
      <Setter Property='Template'>
        <Setter.Value>
          <ControlTemplate TargetType='ListBox'>
            <ScrollViewer Focusable='False' Padding='0' VerticalScrollBarVisibility='Auto' HorizontalScrollBarVisibility='Disabled'><ItemsPresenter/></ScrollViewer>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property='ItemContainerStyle'>
        <Setter.Value>
          <Style TargetType='ListBoxItem'>
            <Setter Property='Margin' Value='0,0,8,8'/>
            <Setter Property='Foreground' Value='#E8ECF7'/>
            <Setter Property='Padding' Value='0'/>
            <Setter Property='HorizontalContentAlignment' Value='Stretch'/>
            <Setter Property='Template'>
              <Setter.Value>
                <ControlTemplate TargetType='ListBoxItem'>
                  <Border x:Name='bd' CornerRadius='10' Background='#161B2E' BorderBrush='#2A3253' BorderThickness='1'><ContentPresenter/></Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property='IsMouseOver' Value='True'><Setter TargetName='bd' Property='Background' Value='#1D2440'/></Trigger>
                    <Trigger Property='IsSelected' Value='True'><Setter TargetName='bd' Property='BorderBrush' Value='#4C8DFF'/><Setter TargetName='bd' Property='Background' Value='#1D2440'/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ progress ============ -->
    <Style TargetType='ProgressBar'>
      <Setter Property='Height' Value='10'/>
      <Setter Property='Background' Value='#242C4D'/>
      <Setter Property='Foreground' Value='#4C8DFF'/>
      <Setter Property='Template'>
        <Setter.Value>
          <ControlTemplate TargetType='ProgressBar'>
            <Grid>
              <Border CornerRadius='5' Background='{TemplateBinding Background}'/>
              <Border x:Name='PART_Track'><Border x:Name='PART_Indicator' HorizontalAlignment='Left' CornerRadius='5' Background='{TemplateBinding Foreground}'/></Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ text box ============ -->
    <Style TargetType='TextBox'>
      <Setter Property='Background' Value='#10152A'/>
      <Setter Property='Foreground' Value='#E8ECF7'/>
      <Setter Property='CaretBrush' Value='#E8ECF7'/>
      <Setter Property='SelectionBrush' Value='#4C8DFF'/>
      <Setter Property='BorderBrush' Value='#2A3253'/>
      <Setter Property='BorderThickness' Value='1'/>
      <Setter Property='Padding' Value='8,6'/>
      <Setter Property='Template'>
        <Setter.Value>
          <ControlTemplate TargetType='TextBox'>
            <Border Background='{TemplateBinding Background}' BorderBrush='{TemplateBinding BorderBrush}' BorderThickness='{TemplateBinding BorderThickness}' CornerRadius='8'>
              <ScrollViewer x:Name='PART_ContentHost' Margin='{TemplateBinding Padding}'/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ templates ============ -->
    <DataTemplate x:Key='ResultTpl'>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width='5'/><ColumnDefinition Width='*'/><ColumnDefinition Width='Auto'/></Grid.ColumnDefinitions>
        <Border Background='{Binding Accent}' CornerRadius='9,0,0,9'/>
        <StackPanel Grid.Column='1' Margin='12,10,8,10'>
          <TextBlock Text='{Binding Title}' FontWeight='SemiBold' TextTrimming='CharacterEllipsis'/>
          <TextBlock Text='{Binding Sub}' Foreground='#8E99BA' FontSize='11.5' TextTrimming='CharacterEllipsis' Margin='0,2,0,0'/>
          <TextBlock Text='{Binding VerdictText}' Foreground='{Binding Accent}' FontSize='11' FontWeight='SemiBold' Margin='0,5,0,0'/>
        </StackPanel>
        <Border Grid.Column='2' Margin='0,0,12,0' VerticalAlignment='Center' CornerRadius='12' Background='{Binding AccentSoft}' Padding='9,3'>
          <TextBlock Text='{Binding ScoreText}' Foreground='{Binding Accent}' FontWeight='Bold'/>
        </Border>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key='StepTpl'>
      <DockPanel Margin='0,4'>
        <CheckBox DockPanel.Dock='Left' IsChecked='{Binding Selected, Mode=TwoWay}' IsEnabled='{Binding Enabled}' VerticalAlignment='Top' Margin='0,1,2,0'/>
        <TextBlock Text='{Binding Text}' TextWrapping='Wrap' Foreground='#E8ECF7'/>
      </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key='QuarantineTpl'>
      <Grid Margin='14,10'>
        <Grid.ColumnDefinitions><ColumnDefinition Width='*'/><ColumnDefinition Width='Auto'/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text='{Binding Title}' FontWeight='SemiBold' TextTrimming='CharacterEllipsis'/>
          <TextBlock Text='{Binding Sub}' Foreground='#8E99BA' FontSize='11.5' TextTrimming='CharacterEllipsis' Margin='0,2,0,0'/>
          <TextBlock Text='{Binding Meta}' Foreground='#8E99BA' FontSize='11' Margin='0,4,0,0' TextTrimming='CharacterEllipsis'/>
        </StackPanel>
        <Border Grid.Column='1' CornerRadius='10' Background='#232B4A' Padding='9,3' VerticalAlignment='Center'><TextBlock Text='{Binding Kind}' Foreground='#C9D2EE' FontSize='11.5'/></Border>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin='22,16,22,16'>
    <Grid.RowDefinitions>
      <RowDefinition Height='Auto'/>
      <RowDefinition Height='Auto'/>
      <RowDefinition Height='Auto'/>
      <RowDefinition Height='*'/>
    </Grid.RowDefinitions>

    <!-- ================= header ================= -->
    <Grid Grid.Row='0' Margin='0,0,0,14'>
      <Grid.ColumnDefinitions><ColumnDefinition Width='Auto'/><ColumnDefinition Width='*'/><ColumnDefinition Width='Auto'/></Grid.ColumnDefinitions>
      <Border Width='42' Height='42' CornerRadius='12' Background='#4C8DFF'>
        <Viewbox Width='26' Height='26'>
          <Canvas Width='40' Height='40'>
            <Path Data='M20,3 L34,8.5 L34,19 C34,28 28.5,34 20,37.5 C11.5,34 6,28 6,19 L6,8.5 Z' Fill='White' Opacity='0.95'/>
            <Path Data='M13,20 L18,25 L27.5,14.5' Stroke='#4C8DFF' StrokeThickness='3.4' StrokeStartLineCap='Round' StrokeEndLineCap='Round' StrokeLineJoin='Round'/>
          </Canvas>
        </Viewbox>
      </Border>
      <StackPanel Grid.Column='1' Margin='14,0,0,0' VerticalAlignment='Center'>
        <TextBlock x:Name='TitleText' Text='MineHunter' FontSize='21' FontWeight='Bold'/>
        <TextBlock x:Name='TaglineText' Foreground='#8E99BA' FontSize='12'/>
      </StackPanel>
      <StackPanel Grid.Column='2' Orientation='Horizontal' VerticalAlignment='Center'>
        <Border x:Name='UpdatePill' CornerRadius='15' Padding='13,6' Background='#1D2440' BorderBrush='#2A3253' BorderThickness='1' Cursor='Hand' Margin='0,0,10,0'>
          <TextBlock x:Name='UpdateText' FontSize='12' FontWeight='SemiBold'/>
        </Border>
        <Border CornerRadius='9' Background='#1D2440' Padding='2'>
          <StackPanel Orientation='Horizontal'>
            <Button x:Name='BtnRu' Content='RU' Style='{StaticResource BtnSeg}'/>
            <Button x:Name='BtnEn' Content='EN' Style='{StaticResource BtnSeg}'/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <!-- ================= hero ================= -->
    <Border Grid.Row='1' Background='#161B2E' CornerRadius='16' Padding='22' BorderBrush='#2A3253' BorderThickness='1'>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width='Auto'/><ColumnDefinition Width='*'/><ColumnDefinition Width='Auto'/></Grid.ColumnDefinitions>
        <Border x:Name='HeroIcon' Width='78' Height='78' CornerRadius='39' Background='#2A3253' VerticalAlignment='Center'>
          <TextBlock x:Name='HeroGlyph' FontSize='36' FontWeight='Bold' Foreground='White' HorizontalAlignment='Center' VerticalAlignment='Center'/>
        </Border>
        <StackPanel Grid.Column='1' Margin='22,0' VerticalAlignment='Center'>
          <TextBlock x:Name='HeroTitle' FontSize='25' FontWeight='Bold' TextTrimming='CharacterEllipsis'/>
          <TextBlock x:Name='HeroSub' Foreground='#8E99BA' TextWrapping='Wrap' Margin='0,4,0,0'/>
          <ProgressBar x:Name='Prog' Margin='0,14,0,0' Minimum='0' Maximum='100' Visibility='Collapsed'/>
          <TextBlock x:Name='ProgText' Foreground='#8E99BA' FontSize='12' Margin='0,6,0,0' TextTrimming='CharacterEllipsis' Visibility='Collapsed'/>
          <WrapPanel x:Name='Chips' Margin='0,14,0,0' Visibility='Collapsed'/>
        </StackPanel>
        <StackPanel Grid.Column='2' VerticalAlignment='Center' MinWidth='230'>
          <StackPanel x:Name='ScanButtons'>
            <Button x:Name='BtnQuick' Style='{StaticResource BtnPrimary}' Padding='16,12' FontSize='14'/>
            <Grid Margin='0,8,0,0'>
              <Grid.ColumnDefinitions><ColumnDefinition Width='*'/><ColumnDefinition Width='8'/><ColumnDefinition Width='*'/></Grid.ColumnDefinitions>
              <Button x:Name='BtnFull' Style='{StaticResource Btn}'/>
              <Button x:Name='BtnCustom' Grid.Column='2' Style='{StaticResource Btn}'/>
            </Grid>
          </StackPanel>
          <Button x:Name='BtnCancel' Style='{StaticResource BtnGhost}' Visibility='Collapsed'/>
          <Button x:Name='BtnNeutralizeAll' Style='{StaticResource BtnDanger}' Padding='16,12' Margin='0,8,0,0' Visibility='Collapsed'/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ================= system status ================= -->
    <StackPanel Grid.Row='2' Margin='0,12,0,0'>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width='*'/><ColumnDefinition Width='10'/><ColumnDefinition Width='*'/><ColumnDefinition Width='10'/><ColumnDefinition Width='*'/><ColumnDefinition Width='10'/><ColumnDefinition Width='*'/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column='0' Background='#161B2E' CornerRadius='12' Padding='14,10' BorderBrush='#2A3253' BorderThickness='1'>
          <StackPanel><TextBlock x:Name='StProtL' Foreground='#8E99BA' FontSize='11.5'/><TextBlock x:Name='StProtV' FontWeight='SemiBold' TextTrimming='CharacterEllipsis' Margin='0,3,0,0'/></StackPanel>
        </Border>
        <Border Grid.Column='2' Background='#161B2E' CornerRadius='12' Padding='14,10' BorderBrush='#2A3253' BorderThickness='1'>
          <StackPanel><TextBlock x:Name='StLastL' Foreground='#8E99BA' FontSize='11.5'/><TextBlock x:Name='StLastV' FontWeight='SemiBold' TextTrimming='CharacterEllipsis' Margin='0,3,0,0'/></StackPanel>
        </Border>
        <Border Grid.Column='4' Background='#161B2E' CornerRadius='12' Padding='14,10' BorderBrush='#2A3253' BorderThickness='1'>
          <StackPanel><TextBlock x:Name='StQuarL' Foreground='#8E99BA' FontSize='11.5'/><TextBlock x:Name='StQuarV' FontWeight='SemiBold' TextTrimming='CharacterEllipsis' Margin='0,3,0,0'/></StackPanel>
        </Border>
        <Border Grid.Column='6' Background='#161B2E' CornerRadius='12' Padding='14,10' BorderBrush='#2A3253' BorderThickness='1'>
          <StackPanel><TextBlock x:Name='StRulesL' Foreground='#8E99BA' FontSize='11.5'/><TextBlock x:Name='StRulesV' FontWeight='SemiBold' TextTrimming='CharacterEllipsis' Margin='0,3,0,0'/></StackPanel>
        </Border>
      </Grid>
      <TextBlock x:Name='PostureToggle' Margin='2,9,0,0' Foreground='#F5B942' FontSize='12' FontWeight='SemiBold' Cursor='Hand' Visibility='Collapsed'/>
      <ItemsControl x:Name='PostureList' Margin='2,4,0,0' Visibility='Collapsed'>
        <ItemsControl.ItemTemplate>
          <DataTemplate><TextBlock Text='{Binding}' Foreground='#F5B942' FontSize='12' TextWrapping='Wrap' Margin='0,1'/></DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- ================= tabs ================= -->
    <TabControl x:Name='Tabs' Grid.Row='3' Margin='0,10,0,0'>
      <TabItem x:Name='TabResults'>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width='380'/><ColumnDefinition Width='*'/></Grid.ColumnDefinitions>
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height='Auto'/><RowDefinition Height='*'/></Grid.RowDefinitions>
            <CheckBox x:Name='CkNotes' Margin='2,0,0,10'/>
            <ListBox x:Name='ResultList' Grid.Row='1' Style='{StaticResource FlatList}' ItemTemplate='{StaticResource ResultTpl}'/>
            <TextBlock x:Name='EmptyText' Grid.Row='1' Foreground='#8E99BA' TextWrapping='Wrap' Margin='4,10,16,0' Visibility='Collapsed'/>
          </Grid>
          <Border Grid.Column='1' Background='#161B2E' CornerRadius='14' BorderBrush='#2A3253' BorderThickness='1'>
            <ScrollViewer x:Name='DetailScroll' VerticalScrollBarVisibility='Auto' HorizontalScrollBarVisibility='Disabled' Padding='0'>
              <StackPanel x:Name='DetailPanel' Margin='22,18,22,18'/>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>
      <TabItem x:Name='TabGraph'>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height='Auto'/><RowDefinition Height='*'/></Grid.RowDefinitions>
          <TextBlock x:Name='GraphHint' Foreground='#8E99BA' TextWrapping='Wrap' Margin='2,0,0,10'/>
          <Border Grid.Row='1' Background='#161B2E' CornerRadius='14' BorderBrush='#2A3253' BorderThickness='1'>
            <ScrollViewer x:Name='GraphScroll' VerticalScrollBarVisibility='Auto' HorizontalScrollBarVisibility='Auto'>
              <Canvas x:Name='GraphCanvas' Width='900' Height='400' HorizontalAlignment='Left' VerticalAlignment='Top'/>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>
      <TabItem x:Name='TabQuarantine'>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height='Auto'/><RowDefinition Height='*'/></Grid.RowDefinitions>
          <StackPanel Orientation='Horizontal' Margin='0,0,0,12'>
            <Button x:Name='BtnQRestore' Style='{StaticResource BtnPrimary}' Margin='0,0,8,0'/>
            <Button x:Name='BtnQDelete' Style='{StaticResource Btn}' Margin='0,0,8,0'/>
            <Button x:Name='BtnQDeleteAll' Style='{StaticResource BtnGhost}' Margin='0,0,8,0'/>
            <Button x:Name='BtnQRefresh' Style='{StaticResource BtnGhost}'/>
          </StackPanel>
          <ListBox x:Name='QList' Grid.Row='1' Style='{StaticResource FlatList}' ItemTemplate='{StaticResource QuarantineTpl}' SelectionMode='Extended'/>
          <TextBlock x:Name='QEmpty' Grid.Row='1' Foreground='#8E99BA' Margin='4,8,0,0' Visibility='Collapsed'/>
        </Grid>
      </TabItem>
      <TabItem x:Name='TabLog'>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height='Auto'/><RowDefinition Height='*'/></Grid.RowDefinitions>
          <StackPanel Orientation='Horizontal' Margin='0,0,0,12'>
            <Button x:Name='BtnOpenReport' Style='{StaticResource Btn}' Margin='0,0,8,0'/>
            <Button x:Name='BtnOpenReports' Style='{StaticResource BtnGhost}' Margin='0,0,8,0'/>
            <Button x:Name='BtnOpenData' Style='{StaticResource BtnGhost}'/>
          </StackPanel>
          <TextBox x:Name='LogBox' Grid.Row='1' IsReadOnly='True' FontFamily='Consolas' FontSize='12' VerticalScrollBarVisibility='Auto' HorizontalScrollBarVisibility='Auto' TextWrapping='NoWrap' AcceptsReturn='True'/>
        </Grid>
      </TabItem>
      <TabItem x:Name='TabAbout'>
        <ScrollViewer VerticalScrollBarVisibility='Auto' HorizontalScrollBarVisibility='Disabled'>
          <StackPanel Margin='0,0,12,20' MaxWidth='880' HorizontalAlignment='Left'>
            <Border Background='#161B2E' CornerRadius='14' BorderBrush='#2A3253' BorderThickness='1' Padding='20'>
              <StackPanel>
                <TextBlock x:Name='AbPrivacyH' FontSize='16' FontWeight='Bold'/>
                <TextBlock x:Name='AbPrivacy' TextWrapping='Wrap' Margin='0,8,0,0' Foreground='#C9D2EE'/>
                <TextBlock x:Name='AbInfo' TextWrapping='Wrap' Margin='0,12,0,0' Foreground='#8E99BA' FontSize='12'/>
              </StackPanel>
            </Border>
