<Project Sdk="Microsoft.NET.Sdk">
  <!-- MinerLab: BENIGN synthetic test harness. Simulates the *observable traits* of a hidden miner
       (CPU/RAM load, odd paths, persistence entries, process chain, localhost-only sockets) and does nothing else. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>MinerSimulation</AssemblyName>
    <RootNamespace>MinerLab</RootNamespace>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>MinerLab benign test harness</AssemblyTitle>
    <Product>MinerLab (benign)</Product>
    <Description>Benign test harness: simulates load and persistence traits for detector testing. Not a miner.</Description>
    <Version>1.0.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>
</Project>
